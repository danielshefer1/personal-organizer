# Copy to .env for local development. .env is gitignored; never commit real values.
#
# Nesting uses a double underscore: DATABASE__APP_URL -> settings.database.app_url

APP__ENV=local
APP__COMPONENT=api
APP__DEBUG=true

# Shared secret for /internal. That router is mounted whenever APP__ENV is not "production",
# so staging serves it publicly -- a staging service with no token set refuses to boot.
# Generate with: uv run python -c "import secrets; print(secrets.token_hex(32))"
APP__INTERNAL_TOKEN=local-dev-internal-token

# Three roles, three DSNs. See src/personal_organizer/db/roles.py for why there are three.
#   bootstrap = superuser: creates the extension and the roles (po-db bootstrap)
#   owner     = app_owner: runs Alembic, owns every table
#   app       = app_user:  the runtime role, RLS-bound, owns nothing
DATABASE__BOOTSTRAP_URL=postgresql://postgres:postgres@localhost:5433/postgres
DATABASE__OWNER_URL=postgresql://app_owner:owner-dev-password@localhost:5433/postgres
DATABASE__APP_URL=postgresql://app_user:app-dev-password@localhost:5433/postgres

# Local logs are easier to read unrendered. Deployed environments must use json;
# the settings validator rejects anything else.
LOGGING__LEVEL=INFO
LOGGING__RENDERER=console
LOGGING__PII_PEPPER=local-dev-pepper-not-secret

# Model IDs are settings so a deprecation is a config change, not a code change.
MODELS__CHAT_MODEL=gpt-5-mini
MODELS__FALLBACK_MODEL=claude-haiku-4-5
MODELS__EMBEDDING_MODEL=text-embedding-3-small
MODELS__TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional locally.
# SENTRY__DSN=
# LANGFUSE__PUBLIC_KEY=
# LANGFUSE__SECRET_KEY=

# Feature flags (Gates 10 and 15).
FLAGS__GROUPS=false
FLAGS__TASKS=false
