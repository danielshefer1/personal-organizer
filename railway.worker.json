{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["src/**", "alembic/**", "pyproject.toml", "uv.lock", "Dockerfile"]
  },
  "deploy": {
    "startCommand": "po-worker",
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 40
  }
}
